# Required: GitHub Fine-Grained Personal Access Token
# Permissions required on the target repository:
#   - Contents: Read and write  (uploads input/jobs/<jobId>/audio.mp3)
#   - Actions: Read and write   (triggers render-lyrics.yml, polls status, downloads artifacts)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target GitHub repository (defaults shown below)
GITHUB_OWNER=duclee13
GITHUB_REPO=lyric-video-renderer
GITHUB_BRANCH=main

# Optional: Protect API routes with a studio passphrase so public visitors
# cannot trigger GitHub Actions renders. Leave empty to disable authentication.
APP_PASSWORD=
