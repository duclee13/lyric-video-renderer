{
  "name": "lyric-video-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Retro-pop kinetic typography lyric video renderer powered by Remotion v4",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LyricVideo ../out/lyric-video.mp4 --props=../data/scenes.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
